{
  "name": "smajti1/laravel-wizard",
  "description": "Wizard component for laravel.",
  "keywords": ["laravel", "wizard", "step", "steps"],
  "license": "MIT",
  "authors": [
    {
      "name": "Hubert Dziubiński",
      "email": "smajti1@gmail.com"
    }
  ],
  "homepage": "https://github.com/smajti1/laravel-wizard",
  "require": {
    "php": "^7.3 || ^8.0",
    "illuminate/http": ">=7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Smajti1\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Smajti1\\LaravelWizard\\Test\\": "tests/"
    }
  },
  "scripts": {
    "php-without-deprecated": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\"",
    "phpunit": "@php-without-deprecated ./vendor/bin/phpunit",
    "phpstan": "@php-without-deprecated vendor/bin/phpstan analyse --configuration=phpstan.neon"
  },
  "config": {
    "policy": {
      "cooldown": {
        "period": "1 day"
      }
    }
  }
}
